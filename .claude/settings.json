{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "5m",
  "omitClaudeMd": true,
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5@20251001",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "permissions": {
    "allow": [
      "python -m pytest",
      "ruff check",
      "ruff format --check",
      "mypy",
      "git diff",
      "git log",
      "git status",
      "uv run pytest",
      "uv run ruff",
      "uv run mypy",
      "bash -n"
    ],
    "deny": [
      "cat .env*",
      "type .env*",
      "Get-Content .env*",
      "rm -rf",
      "git push --force",
      "git push -f"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_guard.py\""
          }
        ]
      }
    ]
  }
}
